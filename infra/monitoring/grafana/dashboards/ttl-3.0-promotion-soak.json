  "panels": [
    {
      "id": 100,
      "type": "stat",
      "title": "§11 Overall Pass",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_soak11_overall_pass", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"options": {"0": {"text": "WAITING"}}, "type": "value"},
            {"options": {"1": {"text": "GREEN"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "yellow", "value": null},
            {"color": "green", "value": 1}
          ]}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "textMode": "value"}
    },
    {
      "id": 101,
      "type": "stat",
