{
  "id": null,
  "uid": "ttl-facade",
  "title": "ttl-facade",
  "tags": ["ttl", "phase-00"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Facade Call Rate",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (facade, operation) (rate(ttl_facade_calls_total[5m]))", "legendFormat": "{{facade}} :: {{operation}}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Facade p95 Duration",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, facade, operation) (rate(ttl_facade_duration_seconds_bucket[5m])))", "legendFormat": "{{facade}} :: {{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Prediction Calls (5m)",
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(ttl_facade_calls_total{facade=\"prediction\"}[5m]))", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Settlement Calls (5m)",
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(ttl_facade_calls_total{facade=\"settlement\"}[5m]))", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Shadow Diff Rows",
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_settlement_diff_rows", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Shadow Diff Disagreements",
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_settlement_diff_disagreements", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    }
  ]
}
