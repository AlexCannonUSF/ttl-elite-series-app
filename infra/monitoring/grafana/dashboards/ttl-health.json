{
  "id": null,
  "uid": "ttl-health",
  "title": "ttl-health",
  "tags": ["ttl", "phase-00"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Sessions",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_paper_sessions{table=\"primary\",state=\"active\"}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Open Bets",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_paper_bets{status=\"open\"}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current Bankroll",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_paper_bankroll_current", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scrape Errors",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_scrape_errors", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Feed Success Rate (5m)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_feed_success_rate", "legendFormat": "{{source}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Feed Last Success Age (seconds)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ttl_feed_last_success_age_seconds", "legendFormat": "{{source}}", "refId": "A"}]
    }
  ]
}
